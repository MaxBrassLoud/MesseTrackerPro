# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="messe_tracker",  # Must be unique
    name="Messe Tracker",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="messe_tracker_app",
    stack_size=31 * 1024,
    fap_category="MBTools",
    # Optional values
    fap_version="0.2",
    fap_icon="template.png",  # 10x10 1-bit PNG
    fap_description="A Fair Tracker for Tracking und Analysing a Fair Day when most people come etc...",
    fap_author="MaxBrassLoud",
    fap_weburl="https://github.com/MaxBrassLoud/MesseTrackerPro/tree/Flipper",
    fap_icon_assets="images",  # Image assets to compile for this application
)
